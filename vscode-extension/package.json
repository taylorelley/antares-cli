{
  "name": "antares-vscode",
  "displayName": "Antares Security Scanner",
  "description": "Run the Antares CWE vulnerability-localization agent from VS Code against any OpenAI-compatible or Ollama endpoint. Native TypeScript — no Python required.",
  "version": "0.2.0",
  "publisher": "antares",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/taylorelley/antares-cli.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "security",
    "cwe",
    "vulnerability",
    "static analysis",
    "ollama"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "antares.scanForCwe",
        "title": "Scan Folder for CWE…",
        "category": "Antares"
      },
      {
        "command": "antares.autoSweep",
        "title": "Auto-Sweep Folder for Vulnerabilities",
        "category": "Antares"
      },
      {
        "command": "antares.setApiKey",
        "title": "Set API Key",
        "category": "Antares"
      },
      {
        "command": "antares.clearApiKey",
        "title": "Clear API Key",
        "category": "Antares"
      },
      {
        "command": "antares.showLastReport",
        "title": "Show Last Report (JSON)",
        "category": "Antares"
      },
      {
        "command": "antares.saveReport",
        "title": "Save Report…",
        "category": "Antares"
      },
      {
        "command": "antares.sastScan",
        "title": "Run SAST Scan (Opengrep)",
        "category": "Antares"
      },
      {
        "command": "antares.sastScanAndVerify",
        "title": "Run SAST Scan + Verify with Antares",
        "category": "Antares"
      },
      {
        "command": "antares.clearResults",
        "title": "Clear Results",
        "category": "Antares",
        "icon": "$(clear-all)"
      },
      {
        "command": "antares.showReport",
        "title": "Open Report (Webview)",
        "category": "Antares"
      },
      {
        "command": "antares.showHistory",
        "title": "Show Scan History",
        "category": "Antares"
      },
      {
        "command": "antares.testConnection",
        "title": "Test Connection",
        "category": "Antares"
      },
      {
        "command": "antares.showOutput",
        "title": "Show Output Channel",
        "category": "Antares"
      },
      {
        "command": "antares.verifyFinding",
        "title": "Verify Finding with Antares",
        "category": "Antares"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "antares",
          "title": "Antares",
          "icon": "media/antares.svg"
        }
      ]
    },
    "views": {
      "antares": [
        {
          "id": "antaresResults",
          "name": "Findings",
          "icon": "media/antares.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "antaresResults",
        "contents": "No Antares scan has run yet.\n[Scan Folder for CWE…](command:antares.scanForCwe)\n[Auto-Sweep Folder](command:antares.autoSweep)\nConfigure your model endpoint in [settings](command:workbench.action.openSettings?%22antares%22)."
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "antares.scanForCwe",
          "when": "explorerResourceIsFolder",
          "group": "antares@1"
        },
        {
          "command": "antares.autoSweep",
          "when": "explorerResourceIsFolder",
          "group": "antares@2"
        },
        {
          "command": "antares.sastScan",
          "when": "explorerResourceIsFolder",
          "group": "antares@3"
        },
        {
          "command": "antares.sastScanAndVerify",
          "when": "explorerResourceIsFolder",
          "group": "antares@4"
        }
      ],
      "view/title": [
        {
          "command": "antares.clearResults",
          "when": "view == antaresResults",
          "group": "navigation"
        }
      ]
    },
    "walkthroughs": {
      "start": {
        "title": "Get Started with Antares",
        "description": "Configure your endpoint and run your first security scan.",
        "steps": [
          {
            "id": "installed",
            "title": "Antares is installed",
            "description": "The Antares Security Scanner extension is active. Proceed to configure your endpoint.",
            "media": {
              "markdown": "media/walkthrough.md#step-1-install"
            }
          },
          {
            "id": "configureEndpoint",
            "title": "Configure your inference endpoint",
            "description": "Set the provider, endpoint URL, and model ID in Antares settings.",
            "media": {
              "markdown": "media/walkthrough.md#step-2-configure-endpoint"
            },
            "completionEvents": [
              "onCommand:antares.testConnection"
            ],
            "when": "config.antares.model != '' && config.antares.endpoint != ''"
          },
          {
            "id": "testConnection",
            "title": "Test the connection",
            "description": "Verify your endpoint is reachable and the model is available.",
            "media": {
              "markdown": "media/walkthrough.md#step-3-test-connection"
            },
            "button": {
              "command": "antares.testConnection",
              "title": "Test Connection"
            },
            "completionEvents": [
              "onCommand:antares.testConnection"
            ]
          },
          {
            "id": "firstScan",
            "title": "Run your first scan",
            "description": "Run a SAST scan or a CWE-targeted scan to find vulnerabilities.",
            "media": {
              "markdown": "media/walkthrough.md#step-4-first-scan"
            },
            "button": {
              "command": "antares.sastScan",
              "title": "Run SAST Scan"
            },
            "completionEvents": [
              "onView:antaresResults"
            ]
          }
        ]
      }
    },
    "configuration": {
      "title": "Antares",
      "properties": {
        "antares.provider": {
          "type": "string",
          "enum": [
            "ollama",
            "openai-compatible",
            "vllm",
            "custom"
          ],
          "enumDescriptions": [
            "Ollama server exposing the OpenAI-compatible API (chat completions). Defaults to http://localhost:11434/v1.",
            "Any OpenAI-compatible server using the chat completions API.",
            "vLLM-hosted Antares checkpoints using the raw completions API and Granite template.",
            "Custom endpoint; use the API Style setting to choose chat or completions."
          ],
          "default": "ollama",
          "markdownDescription": "Connection preset. Selects sensible defaults for the API style and endpoint. Override individual fields below as needed."
        },
        "antares.endpoint": {
          "type": "string",
          "default": "",
          "markdownDescription": "Inference endpoint base URL (e.g. `http://localhost:11434/v1`). Leave empty to use the provider default (Ollama only)."
        },
        "antares.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "Served model ID. Must match the identifier exposed by your endpoint exactly (e.g. `qwen2.5-coder:7b`, `antares-1b`)."
        },
        "antares.apiStyle": {
          "type": "string",
          "enum": [
            "auto",
            "chat",
            "completions"
          ],
          "default": "auto",
          "markdownDescription": "Which OpenAI-compatible API to call. `auto` derives it from the provider (chat for Ollama/OpenAI-compatible, completions for vLLM). `chat` targets `/v1/chat/completions`; `completions` targets `/v1/completions`."
        },
        "antares.toolBudget": {
          "type": "number",
          "default": 0,
          "markdownDescription": "Repository tool-call budget per scan. `0` uses the Antares default."
        },
        "antares.sweep.workers": {
          "type": "number",
          "default": 4,
          "markdownDescription": "Number of parallel CWE workers used by Auto-Sweep."
        },
        "antares.sweep.maxCwes": {
          "type": "number",
          "default": 8,
          "markdownDescription": "Maximum number of CWE classes Auto-Sweep will select automatically."
        },
        "antares.diagnosticsSeverity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "hint"
          ],
          "default": "warning",
          "markdownDescription": "Severity used for findings reported in the Problems panel."
        },
        "antares.opengrep.binaryPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Override path to the opengrep binary. Leave empty to use the bundled binary for your platform."
        },
        "antares.opengrep.rulesPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Override path to opengrep rules directory. Leave empty to use bundled rules."
        },
        "antares.opengrep.severity": {
          "type": "string",
          "enum": [
            "ERROR",
            "WARNING",
            "INFO",
            "ALL"
          ],
          "default": "ALL",
          "markdownDescription": "Minimum severity to report from SAST scan."
        },
        "antares.opengrep.timeoutSeconds": {
          "type": "number",
          "default": 300,
          "markdownDescription": "Timeout for opengrep scan in seconds."
        },
        "antares.opengrep.ignoreGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Glob patterns to exclude from SAST scan."
        },
        "antares.opengrep.maxVerifiedFindings": {
          "type": "number",
          "default": 25,
          "markdownDescription": "Maximum number of SAST findings to verify with the Antares agent (0 disables verification). Grouped by file+CWE."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "test-unit": "node --test out-test/test/*.test.js",
    "pretest-unit": "tsc -p tsconfig.test.json",
    "vsix": "vsce package --no-dependencies",
    "fetch-opengrep": "node tools/fetch-opengrep.mjs",
    "fetch-opengrep:all": "node tools/fetch-opengrep.mjs --all"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5"
  }
}
